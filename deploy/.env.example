# copy to .env

# Hostname under which Anytype apps reach the sync server.
# Only read on the first start of any-sync.
SYNC_HOST=sync.example.com
# Optional: advertise more addresses, comma-separated (default: SYNC_HOST)
#SYNC_ADDRS=sync.example.com,192.168.1.100

# Directory with the client-config.yml of the sync network.
# Default ./data/any-sync, written by the bundled any-sync (profile "sync").
# For an existing network: a directory with a copy of its client-config.yml
# (see deploy/README.md).
#SYNC_CONFIG_DIR=./sync

# anypub image tag: main, or a release such as 0.1.0
#ANYPUB_VERSION=main

# Public base URL of the published pages
PUB_BASE_URL=https://pub.example.com

# Spaces anypub watches: id[:tag],id[:tag]
ANYPUB_SPACES=bafyrei...

# Output directory, served by nginx on the host
PUBLIC_DIR=/srv/anypub/public
